# Application Configuration
APP_NAME="GiftMind API"
APP_ENV=development
DEBUG=True
API_V1_STR=/api/v1

# PostgreSQL Async Database Connection
# Format: postgresql+asyncpg://<username>:<password>@<host>:<port>/<dbname>
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/giftmind

# Database Connection Pool Settings
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
DB_ECHO=False

# CORS Allowed Origins (JSON array of allowed origins)
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Authentication & Security
JWT_SECRET_KEY=change-this-to-a-secure-random-32-byte-secret-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# AI Inference Settings (Google Gemini API — Hosted Gemma 4)
# Free tier quotas: 30 RPM, 16,000 TPM, 14,400 RPD
# Get a free API key at https://aistudio.google.com/
AI_PROVIDER=google
GOOGLE_API_KEY=
GEMMA_MODEL=gemma-4-26b-a4b-it
AI_REQUEST_TIMEOUT_SECONDS=90.0

